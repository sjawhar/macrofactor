# MacroFactor credentials — provide EITHER a refresh token OR username+password.
# MACROFACTOR_AUTH_TOKEN takes precedence if both are set.
#
# Refresh token (recommended for servers): long-lived, revocable via password change.
# Capture once via `mf login` (prints refreshToken to stdout), then replace the
# username/password pair with this var in your deployment env.
MACROFACTOR_AUTH_TOKEN=

# Username + password (fallback)
MACROFACTOR_USERNAME=your@email.com
MACROFACTOR_PASSWORD=your-password

# Firebase & Typesense keys (from app — required for API access)
FIREBASE_WEB_API_KEY=
TYPESENSE_HOST=
TYPESENSE_API_KEY=
